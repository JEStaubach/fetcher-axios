    "@microsoft/eslint-formatter-sarif": "^3.1.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-istanbul": "^5.0.3",
    "builtin-modules": "^5.4.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "typescript": "^6.0.3",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "engines": {
    "node": ">=22"
  }
