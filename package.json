  "private": false,
  "type": "module",
  "main": "./dist/fetcher-axios.umd.cjs",
  "module": "./dist/fetcher-axios.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/fetcher-axios.js",
      "require": "./dist/fetcher-axios.umd.cjs"
    }
  },
  "files": [
